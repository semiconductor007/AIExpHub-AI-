# Backend-only AI summary configuration. Restart the backend after editing backend/.env.
# Copy to backend/.env and fill locally. Never put keys in frontend/VITE_* variables.
# Set true after filling your key and an available model ID.
AI_SUMMARY_ENABLED=false

# Fill the actual secret here in backend/.env, never in this tracked example.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Fill a model ID available to your DeepSeek account.
DEEPSEEK_MODEL=

# Runtime limits. Requests are manual and never automatically retried.
AI_SUMMARY_TIMEOUT_SECONDS=60
AI_SUMMARY_MAX_OUTPUT_TOKENS=3000
AI_SUMMARY_MAX_EXPERIMENTS=10
AI_SUMMARY_MAX_INPUT_BYTES=32768
