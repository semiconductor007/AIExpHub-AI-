# AI summary configuration reservation only; runtime loading is not implemented yet.
# Copy to backend/.env and fill locally. Never put keys in frontend/VITE_* variables.
# Keep disabled until the AI summary implementation and validation are complete.
AI_SUMMARY_ENABLED=false

# Fill the actual secret here in backend/.env, never in this tracked example.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Fill a model ID available to your DeepSeek account when integration is implemented.
DEEPSEEK_MODEL=

# Proposed limits; these are not active runtime settings yet.
AI_SUMMARY_TIMEOUT_SECONDS=60
AI_SUMMARY_MAX_OUTPUT_TOKENS=3000
AI_SUMMARY_MAX_EXPERIMENTS=10
AI_SUMMARY_MAX_INPUT_BYTES=32768
